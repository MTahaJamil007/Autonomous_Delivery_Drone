<?xml version="1.0"?>
<model>
  <name>pad_0</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    2.0 x 2.0 m delivery landing pad carrying ArUco DICT_4X4_50 marker ID 0.

    Texture vendored from PX4's arucotag_0 model, which (unlike the plain
    "arucotag" model) has the white quiet zone ArUco's contour detector
    requires. See finding F1 in docs/ARCHITECTURE.md.

    Size is 2.0 m, not the 0.5 m of the source model, because a 0.5 m marker
    subtends only 14 px at 10 m cruise altitude and cannot be decoded
    (finding F3). At 2.0 m it subtends 55 px. Keep in sync with
    config.PAD_SIZE_M.
  </description>
</model>
